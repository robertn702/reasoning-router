REASONING_ROUTER_PORT=4320
# Classifier provider: jev (default) or clef.
# REASONING_ROUTER_CLASSIFIER=jev
# jev: TypeSafe key by default; Gateway requires its credential AND the URL below.
# clef: Cloudflare Workers AI API token.
REASONING_ROUTER_CLASSIFIER_API_KEY=
# REASONING_ROUTER_CLASSIFIER_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# clef only: Cloudflare account ID and model (clef or clef-flash).
# REASONING_ROUTER_CLASSIFIER_ACCOUNT_ID=
# REASONING_ROUTER_CLASSIFIER_MODEL=clef-flash
# Required: any Responses API-compatible base URL that serves GPT-6 models.
REASONING_ROUTER_UPSTREAM_BASE_URL=https://api.openai.com/v1
# bearer: the router sends REASONING_ROUTER_UPSTREAM_API_KEY (HTTPS or loopback).
# forward: the router passes the client's Authorization header (loopback only).
REASONING_ROUTER_UPSTREAM_AUTH=bearer
REASONING_ROUTER_UPSTREAM_API_KEY=
# Optional Anthropic Messages API upstream. Uses REASONING_ROUTER_UPSTREAM_AUTH policy.
# REASONING_ROUTER_ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com/v1
# REASONING_ROUTER_ANTHROPIC_UPSTREAM_API_KEY=
# REASONING_ROUTER_BASE_EFFORT=medium
REASONING_ROUTER_CLASSIFICATION_TIMEOUT_MS=4000
REASONING_ROUTER_MAX_RETRIES=1
REASONING_ROUTER_FALLBACK_MODE=fixed
REASONING_ROUTER_FALLBACK_EFFORT=high
# REASONING_ROUTER_DECISIONS_LOG_PATH=/absolute/path/to/reasoning-decisions.jsonl
REASONING_ROUTER_MAX_REQUEST_BYTES=1048576
REASONING_ROUTER_MAX_IN_FLIGHT=32
REASONING_ROUTER_UPSTREAM_HEADER_TIMEOUT_MS=10000
REASONING_ROUTER_UPSTREAM_IDLE_TIMEOUT_MS=60000
REASONING_ROUTER_EFFORT_CACHE_ENTRIES=256
REASONING_ROUTER_EFFORT_CACHE_TTL_MS=600000
REASONING_ROUTER_SHUTDOWN_GRACE_MS=30000
