{
  "name": "@reasoning-router/pi",
  "version": "0.0.0",
  "description": "Adaptive per-step reasoning effort for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git",
    "directory": "packages/pi"
  },
  "keywords": [
    "pi-package",
    "pi",
    "reasoning-effort"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "exports": {
    ".": {
      "@reasoning-router/source": "./src/extension.ts",
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@reasoning-router/classifiers": "^0.0.0",
    "@reasoning-router/core": "^0.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.4"
  }
}
