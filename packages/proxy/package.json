{
  "name": "@reasoning-router/proxy",
  "version": "0.1.4",
  "description": "Standalone adaptive reasoning effort proxy for Responses and Messages API clients",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git",
    "directory": "packages/proxy"
  },
  "keywords": [
    "reasoning-effort",
    "proxy",
    "openai",
    "anthropic"
  ],
  "bin": {
    "reasoning-router": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@reasoning-router/classifiers": "^0.4.0",
    "@reasoning-router/core": "^0.2.0",
    "zod": "^4.6.5"
  }
}
