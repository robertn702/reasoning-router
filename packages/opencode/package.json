{
  "name": "@reasoning-router/opencode",
  "version": "0.0.0",
  "description": "Adaptive per-step reasoning effort for OpenCode V2",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git",
    "directory": "packages/opencode"
  },
  "keywords": [
    "opencode-plugin",
    "opencode",
    "reasoning-effort"
  ],
  "exports": {
    ".": {
      "@reasoning-router/source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./plugin": {
      "@reasoning-router/source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@reasoning-router/classifiers": "^0.0.0",
    "@reasoning-router/core": "^0.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@opencode/schema": "2.0.18"
  }
}
