{
  "name": "@reasoning-router/classifiers",
  "version": "0.5.0",
  "description": "Reasoning-effort classifiers (Jev, Clef, Laya, Kev, OpenAI Decisions, CLM, Microsoft-Decision-1, Liquid d1, OpenRouter) for reasoning-router",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git",
    "directory": "packages/classifiers"
  },
  "keywords": [
    "reasoning-effort",
    "classifier",
    "jev",
    "typesafe",
    "clef",
    "cloudflare",
    "laya",
    "kev",
    "openai",
    "decisions",
    "clm",
    "microsoft",
    "foundry",
    "liquid",
    "d1",
    "openrouter"
  ],
  "exports": {
    ".": {
      "@reasoning-router/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@reasoning-router/core": "^0.2.0",
    "zod": "^4.6.5"
  }
}
