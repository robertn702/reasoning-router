{
  "name": "@reasoning-router/classifier-jev",
  "version": "0.0.0",
  "description": "Jev (TypeSafe) classifier for reasoning-router",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git",
    "directory": "packages/classifier-jev"
  },
  "keywords": [
    "reasoning-effort",
    "jev",
    "typesafe"
  ],
  "exports": {
    ".": {
      "@reasoning-router/source": "./src/jev.ts",
      "types": "./dist/jev.d.ts",
      "default": "./dist/jev.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@reasoning-router/core": "^0.0.0",
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
