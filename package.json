{
  "name": "reasoning-router",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "npm run build -w @reasoning-router/core -w @reasoning-router/classifiers -w @reasoning-router/opencode -w @reasoning-router/pi -w @reasoning-router/proxy",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "biome check --write .",
    "lint": "biome check .",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:pi": "node scripts/smoke-pi.mjs",
    "smoke:plugin:v2": "node scripts/plugin-smoke-v2.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
