{
  "name": "reasoning-router",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/reasoning-router.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
